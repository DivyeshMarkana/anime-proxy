# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://mac.video.com,http://localhost:4200

# URL streaming mode for GET /api/videos/stream?url=
#   allowlist — only hosts listed in ALLOWED_UPSTREAM_HOSTS (and BASE_URL host)
#   any       — any public http(s) host; REQUIRES PROXY_API_KEY (SSRF-blocked)
URL_PROXY_MODE=any

# Optional upstream provider for ID-based routes: GET /api/videos/:videoId
VIDEO_PROVIDER_BASE_URL=
VIDEO_PROVIDER_TOKEN=

# How the proxy authenticates with BASE_URL host only:
#   bearer | header | query | signed-url
VIDEO_PROVIDER_AUTH_TYPE=bearer
VIDEO_PROVIDER_AUTH_HEADER=X-Api-Key
VIDEO_PROVIDER_AUTH_QUERY_PARAM=token

# Path template for ID mode. Must include {videoId} when BASE_URL is set.
VIDEO_PROVIDER_PATH_TEMPLATE=/videos/{videoId}

# Fixed Referer header sent on every upstream fetch (server-side only).
# Example: https://zokoanime.video/
VIDEO_PROVIDER_REFERER=

# Hosts allowed when URL_PROXY_MODE=allowlist (ignored for host checks when mode=any)
# Comma-separated hostnames. BASE_URL host is always included when set.
ALLOWED_UPSTREAM_HOSTS=

# Optional extra headers — only sent when talking to VIDEO_PROVIDER_BASE_URL host
VIDEO_PROVIDER_EXTRA_HEADERS=

# Upstream request timeout in milliseconds
UPSTREAM_TIMEOUT=30000

# Required for URL_PROXY_MODE=any (min 16 chars). Also required in production.
# Clients: Authorization: Bearer <key> or X-API-Key: <key>
PROXY_API_KEY=change-me-to-a-long-random-secret

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
